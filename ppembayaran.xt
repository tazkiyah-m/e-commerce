<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta content="width=device-width, initial-scale=1.0" name="viewport"><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config={theme:{extend:{"colors":{"surface-container-lowest":"#ffffff","secondary-container":"#dfe0e0","primary-fixed-dim":"#c6c6c6","on-tertiary":"#ffffff","secondary":"#5d5f5f","tertiary-container":"#291800","surface":"#f9f9fb","inverse-primary":"#c6c6c6","tertiary-fixed-dim":"#ffb955","surface-container-high":"#e8e8ea","on-secondary":"#ffffff","surface-tint":"#5e5e5e","outline-variant":"#cfc4c5","on-primary-fixed":"#1b1b1b","on-tertiary-fixed-variant":"#633f00","surface-container-highest":"#e2e2e4","on-primary":"#ffffff","outline":"#7e7576","on-primary-container":"#848484","on-background":"#1a1c1d","background":"#f9f9fb","on-error":"#ffffff","on-surface-variant":"#4c4546","on-secondary-container":"#616363","surface-dim":"#d9dadc","inverse-on-surface":"#f0f0f2","primary":"#000000","surface-bright":"#f9f9fb","primary-container":"#1b1b1b","inverse-surface":"#2f3132","surface-container-low":"#f3f3f5","surface-container":"#eeeef0","on-tertiary-fixed":"#291800","error-container":"#ffdad6","on-surface":"#1a1c1d","tertiary":"#000000","on-secondary-fixed-variant":"#454747","secondary-fixed-dim":"#c6c6c7","surface-variant":"#e2e2e4","on-error-container":"#93000a","error":"#ba1a1a","secondary-fixed":"#e2e2e2","on-secondary-fixed":"#1a1c1c","on-tertiary-container":"#b57700","primary-fixed":"#e2e2e2","tertiary-fixed":"#ffddb4","on-primary-fixed-variant":"#474747"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"gutter-mobile":"16px","unit":"8px","margin-desktop":"48px","container-max":"1200px","gutter-desktop":"24px","margin-mobile":"20px"},"fontFamily":{"headline-md":["Inter"],"label-sm":["Inter"],"display-lg":["Inter"],"body-lg":["Inter"],"body-md":["Inter"],"display-lg-mobile":["Inter"],"label-md":["Inter"],"headline-sm":["Inter"]},"fontSize":{"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"600"}],"label-sm":["12px",{"lineHeight":"16px","letterSpacing":"0.05em","fontWeight":"600"}],"display-lg":["48px",{"lineHeight":"56px","letterSpacing":"-0.02em","fontWeight":"700"}],"body-lg":["18px",{"lineHeight":"28px","letterSpacing":"0","fontWeight":"400"}],"body-md":["16px",{"lineHeight":"24px","letterSpacing":"0","fontWeight":"400"}],"display-lg-mobile":["32px",{"lineHeight":"40px","letterSpacing":"-0.01em","fontWeight":"700"}],"label-md":["14px",{"lineHeight":"20px","letterSpacing":"0.01em","fontWeight":"500"}],"headline-sm":["20px",{"lineHeight":"28px","letterSpacing":"-0.01em","fontWeight":"600"}]}}}}</script><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
